<!doctype html><html lang="en"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Margin / Study evidence finder</title>
<style>
:root{font-family:ui-sans-serif,system-ui,-apple-system,sans-serif;color:#192720;background:#f8f7f1;--green:#204e40;--light:#dcebdc;--line:#c8d0c3}
*{box-sizing:border-box} body{margin:0} header{border-bottom:1px solid var(--line);padding:15px max(5vw,20px);display:flex;align-items:center;gap:10px;color:var(--green);font-size:20px}header b{font-family:Georgia,serif;font-size:26px} .brand{width:24px;height:24px;background:repeating-linear-gradient(90deg,#244d3d 0 3px,transparent 3px 7px);transform:skew(-12deg)}
main{max-width:1200px;margin:auto;padding:30px max(4vw,18px) 65px}h1{font:normal clamp(33px,5vw,62px)/1.06 Georgia,serif;max-width:850px;margin:10px 0 12px;letter-spacing:-.045em} h2{font:normal 27px/1.25 Georgia,serif;margin:0 0 12px}.intro{max-width:700px;font-size:16px;line-height:1.5;margin:0 0 25px;color:#3c5048}.layout{display:grid;grid-template-columns:1fr 1fr;border-top:1px solid var(--line);gap:32px;padding-top:23px}.group{display:flex;justify-content:space-between;align-items:baseline;gap:12px}.note{font-size:13px;color:#43554b}.field{border:1px solid #a5b3a6;background:#fffef9;border-radius:7px;padding:13px;display:block;width:100%;font:15px/1.55 ui-monospace,monospace;resize:vertical;color:inherit}#notes{min-height:290px}#claim{min-height:85px}.links{display:flex;gap:6px;flex-wrap:wrap;margin:12px 0}.links button,.ghost{background:transparent;border:1px solid var(--line);border-radius:20px;padding:6px 10px;color:var(--green);font:inherit;font-size:13px;cursor:pointer}.primary{border:0;border-radius:6px;background:var(--green);color:white;padding:12px 18px;font-weight:650;font-size:15px;cursor:pointer}.row{display:flex;align-items:center;gap:12px;margin-top:10px}.status{font-size:14px}.results{margin-top:25px;border-top:1px solid var(--line);padding-top:14px}.results h3{font-size:17px;margin:4px 0 10px}.card{padding:12px 0;border-top:1px solid var(--line)}.line{display:grid;grid-template-columns:25px 1fr;gap:7px;margin:5px 0;font:15px/1.5 Georgia,serif}.num{color:#52665b;font:12px/1.8 ui-monospace,monospace;text-align:right}.flag{margin:8px 0;color:#834018;font-size:14px;line-height:1.4}.ref{font:600 13px/1.5 ui-monospace,monospace;color:var(--green)}button:focus-visible,a:focus-visible,textarea:focus-visible{outline:3px solid #ad7100;outline-offset:3px}.outside{margin-top:14px}.meter{color:#536558}.error{color:#8c2922} @media(max-width:745px){.layout{grid-template-columns:1fr;gap:24px}#notes{min-height:155px}}
</style>
<header><span class="brand" aria-hidden="true"></span><b>Margin</b></header>
<main><h1>Where did that quiz claim come from?</h1><p class="intro">Find the lines to reread in your English notes. Compare the exact passage with the claim before deciding what the notes support. Your text stays in this browser tab.</p>
<div class="layout">
<section><div class="group"><h2><label for="notes">Source notes</label></h2><button class="ghost" id="reset">Load example</button></div>
<textarea class="field" id="notes" maxlength="60000" spellcheck="false" aria-describedby="note-help"></textarea><p class="note" id="note-help">Paste up to 60,000 characters of plain text. Blank lines separate passages. Citations count from the first line.</p></section>
<section><h2><label for="claim">Quiz claim</label></h2><textarea id="claim" class="field" maxlength="800" placeholder="Enter one statement in English."></textarea><div class="links" id="examples" aria-label="Sample claims"></div>
<div class="row"><button class="primary" id="find">Find evidence</button><span aria-live="polite" class="status" id="status"></span></div>
<div id="results" class="results" hidden></div></section></div></main>
<script>/* ENGINE */</script>
<script>
const sample=/* SAMPLE */;
const notes=document.querySelector("#notes"),claim=document.querySelector("#claim"),statusEl=document.querySelector("#status"),results=document.querySelector("#results");
function el(tag,cls,txt){const node=document.createElement(tag);node.className=cls;node.textContent=txt;return node;}
function clearResult(){results.replaceChildren();results.hidden=true;statusEl.textContent="";}
function render(){
  clearResult();if(!notes.value.trim()||!claim.value.trim()){statusEl.textContent="Enter both notes and a claim.";return;}
  const match=MarginEvidence.search(notes.value,claim.value);results.hidden=false;
  if(match.status==="abstain"){results.append(el("h3","","No clear passage found"),el("p","note","The notes may use different wording or may omit the claim. Try a distinctive term from the lecture."));statusEl.textContent="Search complete.";return;}
  results.append(el("h3","",match.status==="ambiguous"?"Multiple passages fit; compare them":match.status==="check"?"Check the wording":"Passage candidates"));
  for(const entry of match.rows){
    const item=el("article","card","");item.append(el("div","ref",entry.start===entry.end?"Line "+entry.start:"Lines "+entry.start+"–"+entry.end));
    entry.text.split("\n").forEach((line,i)=>{const p=el("div","line","");p.append(el("span","num",String(i+entry.start)),el("span","",line));item.append(p);});
    for(const warning of entry.reasons)item.append(el("p","flag",warning));
    results.append(item);
  }
  statusEl.textContent=match.rows.length+" passage"+(match.rows.length===1?"":"s")+" found.";
}
function setSample(index){
  const customNotes=notes.value.trim()!==""&&notes.value!==sample.source;
  const customClaim=claim.value.trim()!==""&&!sample.queries.some(([,text])=>text===claim.value);
  if((customNotes||customClaim)&&!window.confirm("Replace your current notes and quiz claim with the example?"))return;
  notes.value=sample.source;claim.value=sample.queries[index][1];render();
}
sample.queries.forEach(([label],index)=>{const b=el("button","",label);b.onclick=()=>setSample(index);document.querySelector("#examples").append(b);});
document.querySelector("#reset").onclick=()=>setSample(0);
document.querySelector("#find").onclick=render;notes.oninput=clearResult;claim.oninput=clearResult;
claim.onkeydown=e=>{if((e.metaKey||e.ctrlKey)&&e.key==="Enter")render();};
setSample(0);
</script></html>
